const shader = Fn(() => {
  const image1 = texture(_image1_tex, uv().mul(vec2(1, -1)).add(vec2(0, 1)).mul(vec2(2, 3)).add(vec2(0.25, 0.5))).rgb;

  return image1;
});

export default shader;
",
  "wired-dir": "import { Fn, cameraPosition, equirectUV, normalize, positionWorld, sub, texture, uv, vec2 } from 'three/tsl';

const rayDirection = Fn(() => {
  return normalize(sub(positionWorld, cameraPosition));
});

const _image1_img = new Image();
_image1_img.src = "fs-asset:imgA-d8959463"; // x.webp, 2x2 webp, 3 B
let _image1_ok = true;
try { await _image1_img.decode(); } catch { _image1_ok = false; }
const _image1_tex = _image1_ok ? new globalThis.THREE.Texture(_image1_img) : new globalThis.THREE.DataTexture(new Uint8Array([0, 0, 0, 255]), 1, 1, globalThis.THREE.RGBAFormat, globalThis.THREE.UnsignedByteType);
_image1_tex.colorSpace = globalThis.THREE.SRGBColorSpace;
_image1_tex.wrapS = globalThis.THREE.RepeatWrapping;
_image1_tex.wrapT = globalThis.THREE.RepeatWrapping;
_image1_tex.flipY = true;
_image1_tex.needsUpdate = true;

const shader = Fn(() => {
  const rayDirection1 = rayDirection();
  const image1 = texture(_image1_tex, equirectUV(rayDirection1)).rgb;

  return image1;
});

export default shader;
",
  "wired-uv": "import { Fn, texture, vec2 } from 'three/tsl';

const _image1_img = new Image();
_image1_img.src = "fs-asset:imgA-d8959463"; // x.webp, 2x2 webp, 3 B
