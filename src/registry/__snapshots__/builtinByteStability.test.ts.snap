  const add1 = add(exp1, mul4);
  const sub3 = sub(fract1, 0.5);
  const sub4 = sub(fract2, 0.5);
  const sub5 = sub(fract3, 0.5);
  const mul5 = mul(sub3, sub3);
  const mul6 = mul(sub4, sub4);
  const mul7 = mul(sub5, sub5);
  const add2 = add(mul5, mul6);
  const add3 = add(add2, mul7);
  const sqrt1 = sqrt(add3);
  const smoothstep1 = smoothstep(sub2, add1, sqrt1);
  const mix1 = mix(color1, color2, smoothstep1);

  return vec3(1, 0, 0);
});

export default shader;
",
  "static-noise": "import { Fn, add, mul, mx_noise_float, round, screenUV, sin, time, uniform, vec3 } from 'three/tsl';

const shader = Fn(() => {
  const scale = uniform(80);
  const speed = uniform(30);
  const screenUV1 = screenUV;
  const time1 = time;
  const mul1 = mul(time1, speed);
  const mul2 = mul(screenUV1.x, scale);
  const mul3 = mul(screenUV1.y, scale);
  const round1 = round(mul1);
  const sin1 = sin(round1);
  const mul4 = mul(sin1, 1000);
  const vec31 = vec3(mul2, mul3, mul4);
  const noise1 = mx_noise_float(vec31);
  const mul5 = mul(noise1, 0.5);
  const add1 = add(mul5, 0.5);
  const vec32 = vec3(add1, add1, add1);

  return vec3(1, 0, 0);
});

export default shader;
",
  "tiger-fur": "import { Fn, add, color, div, exp, mix, mul, mx_noise_float, oneMinus, positionGeometry, smoothstep, sub, uniform, vec3 } from 'three/tsl';

const shader = Fn(() => {
  const scale = uniform(2);
  const lengths = uniform(4);
  const blur = uniform(0.3);
  const strength = uniform(0.3);
  const positionGeometry1 = positionGeometry;
  const color1 = color(0xffab00);
  const color2 = color(0xffffed);
  const div1 = div(scale, 2);
  const add1 = add(lengths, 5);
  const mul1 = mul(blur, -1);
  const sub1 = sub(strength, 0.5);
  const add2 = add(div1, 1);
  const div2 = div(1, add1);
  const smoothstep1 = smoothstep(-1, 0.5, positionGeometry1.y);
  const exp1 = exp(add2);
  const mix1 = mix(color2, color1, smoothstep1);
  const mul2 = mul(positionGeometry1.x, exp1);
  const mul3 = mul(positionGeometry1.y, exp1);
  const mul4 = mul(positionGeometry1.z, exp1);
  const mul5 = mul(mul2, add2);
  const mul6 = mul(mul3, div2);
  const mul7 = mul(mul4, div2);
  const vec31 = vec3(mul5, mul6, mul7);
  const noise1 = mx_noise_float(vec31);
  const add3 = add(noise1, sub1);
  const smoothstep2 = smoothstep(mul1, blur, add3);
  const oneMinus1 = oneMinus(smoothstep2);
  const mul8 = mul(mix1, oneMinus1);

  return vec3(1, 0, 0);
});

export default shader;
",
  "wood": "import { Fn, add, color, cos, div, exp, max, mix, mul, mx_noise_float, positionGeometry, sin, sub, uniform, vec3 } from 'three/tsl';

const shader = Fn(() => {
  const scale = uniform(2.5);
  const rings = uniform(4.5);
  const lengths = uniform(1);
  const angle = uniform(0);
  const fibers = uniform(0.3);
  const fibersDensity = uniform(10);
  const positionGeometry1 = positionGeometry;
  const color1 = color(0xcc6600);
  const color2 = color(0x661a00);
  const sub1 = sub(scale, 3);
  const sub2 = sub(scale, 2);
  const max1 = max(lengths, 0.01);
  const mul1 = mul(angle, 0.01745329);
  const exp1 = exp(sub1);
  const exp2 = exp(sub2);
  const div1 = div(1, max1);
  const cos1 = cos(mul1);
  const sin1 = sin(mul1);
  const mul2 = mul(exp1, 4);
  const mul3 = mul(exp2, fibersDensity);
  const mul4 = mul(positionGeometry1.z, exp2);
  const mul5 = mul(exp2, 1.8);
  const mul6 = mul(exp2, 3.24);
  const mul7 = mul(exp2, 5.832);
  const mul8 = mul(exp1, div1);
  const mul9 = mul(positionGeometry1.x, cos1);
  const mul10 = mul(positionGeometry1.y, cos1);
  const mul11 = mul(positionGeometry1.y, sin1);
  const mul12 = mul(positionGeometry1.x, sin1);
  const mul13 = mul(mul3, 1.8);
  const mul14 = mul(mul3, 3.24);
  const mul15 = mul(mul3, 5.832);
  const mul16 = mul(positionGeometry1.z, mul5);
  const mul17 = mul(positionGeometry1.z, mul6);
  const mul18 = mul(positionGeometry1.z, mul7);
  const mul19 = mul(positionGeometry1.z, mul8);
  const sub3 = sub(mul9, mul11);
  const add1 = add(mul12, mul10);
  const mul20 = mul(sub3, mul8);
  const mul21 = mul(sub3, exp2);
  const mul22 = mul(sub3, mul5);
  const mul23 = mul(sub3, mul6);
  const mul24 = mul(sub3, mul7);
  const mul25 = mul(add1, mul2);
  const mul26 = mul(add1, mul3);
  const mul27 = mul(add1, mul13);
  const mul28 = mul(add1, mul14);
  const mul29 = mul(add1, mul15);
  const vec31 = vec3(mul20, mul25, mul19);
  const vec32 = vec3(mul21, mul26, mul4);
  const vec33 = vec3(mul22, mul27, mul16);
  const vec34 = vec3(mul23, mul28, mul17);
  const vec35 = vec3(mul24, mul29, mul18);
  const noise1 = mx_noise_float(vec31);
  const noise2 = mx_noise_float(vec32);
  const noise3 = mx_noise_float(vec33);
  const noise4 = mx_noise_float(vec34);
  const noise5 = mx_noise_float(vec35);
  const add2 = add(noise1, 1);
  const mul30 = mul(2, noise2);
  const mul31 = mul(1.2, noise3);
  const mul32 = mul(0.72, noise4);
  const mul33 = mul(0.432, noise5);
  const mul34 = mul(add2, 10);
  const add3 = add(mul30, mul31);
  const mul35 = mul(mul34, rings);
  const add4 = add(add3, mul32);
  const cos2 = cos(mul35);
  const add5 = add(add4, mul33);
  const add6 = add(mul35, cos2);
  const mul36 = mul(add5, 11.49);
  const cos3 = cos(add6);
  const sin2 = sin(mul36);
  const add7 = add(cos3, 1);
  const add8 = add(sin2, 1);
  const div2 = div(add7, 2);
  const div3 = div(add8, 2);
  const mix1 = mix(div2, div3, fibers);
  const mix2 = mix(color1, color2, mix1);

  return vec3(1, 0, 0);
});

export default shader;
",
}
