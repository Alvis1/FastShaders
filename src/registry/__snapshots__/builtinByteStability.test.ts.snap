  return vec3(1, 0, 0);
});

export default shader;
",
  "studio-shine": "import { Fn, add, cameraPosition, clamp, color, cross, dot, mix, mul, normalWorld, normalize, oneMinus, positionWorld, pow, smoothstep, sub, uniform, vec3 } from 'three/tsl';

