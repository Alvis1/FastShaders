",
  "force-field": "import { Fn, abs, add, cameraPosition, clamp, color, dot, min, mul, normalWorld, normalize, oneMinus, positionWorld, pow, remap, round, sin, smoothstep, sub, time, uniform, uv, vec3 } from 'three/tsl';

const shader = Fn(() => {
  const fieldColor = uniform(color(0x7c4dff));
  const tiling = uniform(12);
  const fieldPulse = uniform(3);
  const positionWorld1 = positionWorld;
  const normalWorld1 = normalWorld;
  const cameraPosition1 = cameraPosition;
  const uv1 = uv();
  const time1 = time;
  const sub1 = sub(cameraPosition1, positionWorld1);
  const mul1 = mul(time1, fieldPulse);
  const normalize1 = normalize(sub1);
  const mul2 = mul(uv1.x, tiling);
  const mul3 = mul(uv1.y, tiling);
  const sin1 = sin(mul1);
  const dot1 = dot(normalWorld1, normalize1);
  const round1 = round(mul2);
  const round2 = round(mul3);
  const remap1 = remap(sin1, -1, 1, 0.5, 1);
  const clamp1 = clamp(dot1, 0, 1);
  const sub2 = sub(mul2, round1);
  const sub3 = sub(mul3, round2);
  const oneMinus1 = oneMinus(clamp1);
  const abs1 = abs(sub2);
  const abs2 = abs(sub3);
  const pow1 = pow(oneMinus1, 2);
  const min1 = min(abs1, abs2);
  const smoothstep1 = smoothstep(0.03, 0.08, min1);
  const oneMinus2 = oneMinus(smoothstep1);
  const mul4 = mul(oneMinus2, 0.5);
  const add1 = add(pow1, mul4);
  const mul5 = mul(add1, remap1);
  const mul6 = mul(fieldColor, mul5);

  return vec3(1, 0, 0);
});

