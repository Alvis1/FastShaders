",
  "edge-glow": "import { Fn, add, cameraPosition, clamp, color, dot, mul, normalWorld, normalize, oneMinus, positionWorld, pow, sub, uniform, vec3 } from 'three/tsl';

const shader = Fn(() => {
  const glowPower = uniform(3);
  const intensity = uniform(2);
  const glowColor = uniform(color(0x00e5ff));
  const coreColor = uniform(color(0x0d1b2a));
  const cameraPosition1 = cameraPosition;
  const positionWorld1 = positionWorld;
  const normalWorld1 = normalWorld;
  const sub1 = sub(cameraPosition1, positionWorld1);
  const normalize1 = normalize(sub1);
  const dot1 = dot(normalWorld1, normalize1);
  const clamp1 = clamp(dot1, 0, 1);
  const oneMinus1 = oneMinus(clamp1);
  const pow1 = pow(oneMinus1, glowPower);
  const mul1 = mul(pow1, intensity);
  const mul2 = mul(glowColor, mul1);
  const add1 = add(coreColor, mul2);

  return vec3(1, 0, 0);
});

