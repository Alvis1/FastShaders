  const edgeWidth = uniform(0.08);
  const dissolveScale = uniform(4);
  const edgeColor = uniform(color(0xff6d00));
  const bodyColor = uniform(color(0x37474f));
  const positionGeometry1 = positionGeometry;
  const add1 = add(dissolveAmount, edgeWidth);
  const mul1 = mul(positionGeometry1, dissolveScale);
  const noise1 = mx_noise_float(mul1);
  const mul2 = mul(noise1, 0.5);
  const add2 = add(mul2, 0.5);
  const smoothstep1 = smoothstep(dissolveAmount, add1, add2);
  const oneMinus1 = oneMinus(smoothstep1);
  const mul3 = mul(bodyColor, smoothstep1);
  const mul4 = mul(smoothstep1, oneMinus1);
  const mul5 = mul(mul4, 4);
  const mul6 = mul(edgeColor, mul5);
  const add3 = add(mul3, mul6);

  return vec3(1, 0, 0);
});

export default shader;
",
  "distance-fog": "import { Fn, cameraPosition, clamp, color, distance, div, length, max, mix, positionWorld, sub, uniform, vec3 } from 'three/tsl';

const shader = Fn(() => {
  const fogNear = uniform(-0.8);
  const fogFar = uniform(0);
  const fogSurfaceColor = uniform(color(0xd84315));
  const fogColor = uniform(color(0xb0bec5));
  const cameraPosition1 = cameraPosition;
  const positionWorld1 = positionWorld;
  const sub1 = sub(fogFar, fogNear);
  const length1 = length(cameraPosition1);
  const distance1 = distance(cameraPosition1, positionWorld1);
  const max1 = max(sub1, 0.001);
  const sub2 = sub(distance1, length1);
  const sub3 = sub(sub2, fogNear);
  const div1 = div(sub3, max1);
  const clamp1 = clamp(div1, 0, 1);
  const mix1 = mix(fogSurfaceColor, fogColor, clamp1);

  return vec3(1, 0, 0);
});

