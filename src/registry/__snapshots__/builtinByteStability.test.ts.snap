// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`built-in textures and presets emit byte-identical code > presets 1`] = `
{
  "checker": "import { Fn, add, color, floor, mix, mod, mul, uniform, uv, vec3 } from 'three/tsl';

const shader = Fn(() => {
  const count = uniform(8);
  const checkColorA = uniform(color(0xfafafa));
  const checkColorB = uniform(color(0x212121));
  const uv1 = uv();
  const mul1 = mul(uv1.x, count);
  const mul2 = mul(uv1.y, count);
  const floor1 = floor(mul1);
  const floor2 = floor(mul2);
  const add1 = add(floor1, floor2);
  const mod1 = mod(add1, 2);
  const mix1 = mix(checkColorA, checkColorB, mod1);

  return vec3(1, 0, 0);
});

export default shader;
",
  "circle": "import { Fn, add, color, distance, max, mix, oneMinus, smoothstep, uniform, uv, vec2, vec3 } from 'three/tsl';

const shader = Fn(() => {
  const discRadius = uniform(0.32);
  const discSoftness = uniform(0.04);
  const discColor = uniform(color(0xffc845));
  const discBackColor = uniform(color(0x14203a));
  const uv1 = uv();
  const vec21 = vec2(0.5, 0.5);
  const max1 = max(discSoftness, 0.001);
  const distance1 = distance(uv1, vec21);
  const add1 = add(discRadius, max1);
  const smoothstep1 = smoothstep(discRadius, add1, distance1);
  const oneMinus1 = oneMinus(smoothstep1);
  const mix1 = mix(discBackColor, discColor, oneMinus1);

  return vec3(1, 0, 0);
});

export default shader;
",
  "color-ramp": "import { Fn, add, clamp, color, cos, mul, uniform, uv, vec3 } from 'three/tsl';

const shader = Fn(() => {
  const baseColor = uniform(color(0x7f7f7f));
  const ampColor = uniform(color(0x7f7f7f));
  const uv1 = uv();
  const vec31 = vec3(0, 0.33, 0.67);
  const add1 = add(vec31, uv1.x);
  const mul1 = mul(add1, 6.2832);
  const cos1 = cos(mul1);
  const mul2 = mul(ampColor, cos1);
  const add2 = add(baseColor, mul2);
  const clamp1 = clamp(add2, 0, 1);

  return vec3(1, 0, 0);
});

export default shader;
",
  "dissolve": "import { Fn, add, color, mul, mx_noise_float, oneMinus, positionGeometry, smoothstep, uniform, vec3 } from 'three/tsl';

