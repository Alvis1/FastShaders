    if (ex < 113) {
      man |= 0x0800;
      return bits | ((man >> (114 - ex)) + ((man >> (113 - ex)) & 1));
    }
    bits |= ((ex - 112) << 10) | (man >> 1);
    return bits + (man & 1);
  };
  const unit = (s) => {
    let dots = 0;
    let digits = 0;
    for (let i = 0; i < s.length; i++) {
      const k = s.charCodeAt(i);
      if (k === 46) dots++;
      else if (k >= 48 && k <= 57) digits++;
      else return null;
    }
    if (dots > 1 || digits === 0 || s.length > 12) return null;
