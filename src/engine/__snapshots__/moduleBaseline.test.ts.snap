  const positionLocal1 = p;
  const sdCircle1 = sdCircle(positionLocal1, 0.5);
  return sdCircle1;
  });
  const rm1Color = color1;
  const rm1 = Fn(() => {
  const stepSize = float(0.03);
  const eps = float(0.002);
  const bend = float(0);
  const horizon = float(0);
  const win = float(1);
  const fieldR = float(1);
  const stepScale = float(1);
  const lightX = float(0.6);
  const lightY = float(0.8);
  const lightZ = float(0.5);
  const ao = float(0);
  const shadow = float(0);
  const cam = modelWorldMatrixInverse.mul(vec4(cameraPosition, 1)).xyz;
