  const gap = max(sub(r, fieldR), float(0));
  const d = rm1Field(pos);
  If(d.lessThan(eps), () => { surfHit.assign(1); hp.assign(pos); Break(); });
  const adv = max(mul(max(d, eps), stepScale), gap);
  pos.addAssign(mul(rd, adv));
  If(alpha.greaterThan(0.995), () => { Break(); });
  });
  const nrm = Fn(([q]) => {
  const e = float(0.001);
  const k1 = vec3(1, -1, -1); const k2 = vec3(-1, -1, 1); const k3 = vec3(-1, 1, -1); const k4 = vec3(1, 1, 1);
