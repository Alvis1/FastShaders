try { await _image3_img.decode(); } catch { _image3_ok = false; }
const _image3_tex = _image3_ok ? new THREE.Texture(_image3_img) : new THREE.DataTexture(new Uint8Array([0, 0, 0, 255]), 1, 1, THREE.RGBAFormat, THREE.UnsignedByteType);
_image3_tex.colorSpace = THREE.NoColorSpace;
