"// TSL Shader Module — for use with a-frame-shaderloader
//
// HTML setup — these two scripts are all you need (no import map, no shim):
//   a-frame-180-a-01.min.js = A-Frame 1.8.0 + Three.js r184 (WebGPU) bundle
//   a-frame-shaderloader-0.8.js rewrites the three/tsl import to that bundle
//   <script src="https://cdn.jsdelivr.net/gh/Alvis1/a-frame-shaderloader@master/js/a-frame-180-a-01.min.js"></script>
//   <script src="https://cdn.jsdelivr.net/gh/Alvis1/a-frame-shaderloader@master/js/a-frame-shaderloader-0.8.js"></script>
//   <a-entity shader="src: shader.js"></a-entity>
//
// Plain Three.js r184 (no A-Frame): put the same loader script on the page,
// then FastShaders.use(THREE) with the three/webgpu namespace and
// FastShaders.apply(mesh, await FastShaders.load('shader.js')). The loader
// builds the uniforms and the material, applies \`parts\`, the weld and corners.
// Without the loader the module still imports THREE and every TSL function it
// calls, and you redo that material work by hand. Recipe:
// https://github.com/Alvis1/FastShaders#using-the-shader-module-with-plain-threejs
//
// This shader embeds image texture(s) as data: URLs. If the host page sets a
// Content-Security-Policy, its img-src directive must allow data:.

import * as THREE from 'three/webgpu';
import { float, mul, normalMap, texture, uv } from 'three/tsl';

export const threeRevision = '184';

const _image1_img = new Image();
_image1_img.src = "<payload>"; // ai-image-0.jpg, 1024x576 webp, 144.0 KB
let _image1_ok = true;
try { await _image1_img.decode(); } catch { _image1_ok = false; }
const _image1_tex = _image1_ok ? new THREE.Texture(_image1_img) : new THREE.DataTexture(new Uint8Array([0, 0, 0, 255]), 1, 1, THREE.RGBAFormat, THREE.UnsignedByteType);
_image1_tex.colorSpace = THREE.SRGBColorSpace;
_image1_tex.minFilter = THREE.NearestMipmapNearestFilter;
_image1_tex.magFilter = THREE.NearestFilter;
_image1_tex.wrapS = THREE.ClampToEdgeWrapping;
_image1_tex.wrapT = THREE.ClampToEdgeWrapping;
_image1_tex.flipY = false;
_image1_tex.needsUpdate = true;
const _image2_img = new Image();
_image2_img.src = "<payload>"; // ai-image-1.png, 4x2 webp, 8 B
let _image2_ok = true;
try { await _image2_img.decode(); } catch { _image2_ok = false; }
const _image2_tex = _image2_ok ? new THREE.Texture(_image2_img) : new THREE.DataTexture(new Uint8Array([0, 0, 0, 255]), 1, 1, THREE.RGBAFormat, THREE.UnsignedByteType);
_image2_tex.colorSpace = THREE.NoColorSpace;
_image2_tex.generateMipmaps = false;
_image2_tex.minFilter = THREE.LinearFilter;
_image2_tex.magFilter = THREE.LinearFilter;
_image2_tex.wrapS = THREE.RepeatWrapping;
_image2_tex.wrapT = THREE.RepeatWrapping;
_image2_tex.flipY = false;
_image2_tex.needsUpdate = true;
const _image3_img = new Image();
_image3_img.src = "<payload>"; // ai-image-2.png, 2x2 webp, 4 B
let _image3_ok = true;
try { await _image3_img.decode(); } catch { _image3_ok = false; }
const _image3_tex = _image3_ok ? new THREE.Texture(_image3_img) : new THREE.DataTexture(new Uint8Array([0, 0, 0, 255]), 1, 1, THREE.RGBAFormat, THREE.UnsignedByteType);
_image3_tex.colorSpace = THREE.NoColorSpace;
_image3_tex.generateMipmaps = false;
_image3_tex.minFilter = THREE.LinearFilter;
_image3_tex.magFilter = THREE.LinearFilter;
_image3_tex.wrapS = THREE.RepeatWrapping;
_image3_tex.wrapT = THREE.RepeatWrapping;
_image3_tex.flipY = false;
_image3_tex.needsUpdate = true;

export default function() {
  const image1 = texture(_image1_tex, uv()).rgb;
  const image2 = texture(_image2_tex, uv(1)).rgba;
  const float1 = float(0.5);
  const image3 = texture(_image3_tex, uv()).rgb;
  const mul1 = mul(image2.b, float1);
  return { parts: { "mesh_0": { colorNode: image1, normalNode: normalMap(image3), roughnessNode: image2.g, metalnessNode: mul1 } }, materialParts: { "0": { colorNode: image1, normalNode: normalMap(image3), roughnessNode: image2.g, metalnessNode: mul1 } }, modelSignature: { materials: ["", "unused"] }, materialPartsMirror: ["mesh_0"] };
}
"
`;

