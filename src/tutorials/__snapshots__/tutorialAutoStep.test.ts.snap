    for (let i = 0; i <= 256; i++) vals.set(ev(i / 256), i * 4);
    return { vals: vals, slopes: null };
  };
  return fsLut.at(fsLut.make('ramp ' + mode + ' ' + stops, mode === 'constant', bake).tex, fac);
};

