      if (k === 46) dots++;
      else if (k >= 48 && k <= 57) digits++;
      else return null;
    }
    if (dots > 1 || digits === 0 || s.length > 12) return null;
    const num = Number(s);
    return num > 1 ? 1 : num;
  };
  const hex = (s) => {
    if (s.length !== 7 || s.charCodeAt(0) !== 35) return null;
