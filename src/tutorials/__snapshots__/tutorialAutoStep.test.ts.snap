    if (ex > 142) return bits | 0x7c00 | (ex === 255 && (w & 0x007fffff) !== 0 ? 0x0200 : 0);
    if (ex < 113) {
      man |= 0x0800;
      return bits | ((man >> (114 - ex)) + ((man >> (113 - ex)) & 1));
