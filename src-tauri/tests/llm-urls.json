{
  "about": "Base-URL cases shared by the desktop local-LLM bridge and its frontend. `rust`: whether src-tauri/src/llm.rs parse_base accepts `input` VERBATIM (and isLoopbackBase in src/llm/endpoint.ts, its mirror for the fetch transport). `normalized`: what normalizeLocalBase in src/llm/endpoint.ts returns for it (UX only: trim, lowercase scheme and host, strip one trailing slash and a trailing /v1), null when refused; every non-null value must itself pass parse_base. Lives under src-tauri/ so the Rust gate still runs in a copy of that folder. Read by llm.rs (include_str!) and src/llm/endpoint.test.ts.",
  "cases": [
    { "input": "http://127.0.0.1:1234", "rust": true, "normalized": "http://127.0.0.1:1234", "why": "LM Studio default" },
    { "input": "http://127.0.0.1:1234/", "rust": true, "normalized": "http://127.0.0.1:1234", "why": "one trailing slash" },
    { "input": "http://localhost:1234", "rust": true, "normalized": "http://localhost:1234", "why": "localhost: 127.0.0.1 first, then ::1" },
    { "input": "http://localhost:11434/", "rust": true, "normalized": "http://localhost:11434", "why": "Ollama default port" },
    { "input": "http://[::1]:8080", "rust": true, "normalized": "http://[::1]:8080", "why": "IPv6 loopback, bracketed" },
    { "input": "http://[::1]:8080/", "rust": true, "normalized": "http://[::1]:8080", "why": "IPv6 loopback, trailing slash" },
    { "input": "http://127.0.0.1:1", "rust": true, "normalized": "http://127.0.0.1:1", "why": "lowest port" },
    { "input": "http://127.0.0.1:65535", "rust": true, "normalized": "http://127.0.0.1:65535", "why": "highest port" },
    { "input": "http://127.0.0.1:65535/", "rust": true, "normalized": "http://127.0.0.1:65535", "why": "highest port, trailing slash" },
    { "input": "http://localhost:8080", "rust": true, "normalized": "http://localhost:8080", "why": "llama.cpp default port" },

    { "input": "http://127.0.0.1:1234/v1", "rust": false, "normalized": "http://127.0.0.1:1234", "why": "the OpenAI-style base people paste" },
    { "input": "http://127.0.0.1:1234/v1/", "rust": false, "normalized": "http://127.0.0.1:1234", "why": "/v1 with a trailing slash" },
    { "input": "http://[::1]:1234/v1", "rust": false, "normalized": "http://[::1]:1234", "why": "IPv6 with /v1" },
    { "input": "  http://localhost:1234  ", "rust": false, "normalized": "http://localhost:1234", "why": "surrounding spaces" },
    { "input": "http://127.0.0.1:1234\n", "rust": false, "normalized": "http://127.0.0.1:1234", "why": "trailing newline" },
    { "input": "\thttp://[::1]:1234/v1\t", "rust": false, "normalized": "http://[::1]:1234", "why": "tabs and /v1" },
    { "input": "HTTP://127.0.0.1:1234", "rust": false, "normalized": "http://127.0.0.1:1234", "why": "upper-case scheme" },
    { "input": "http://LOCALHOST:1234", "rust": false, "normalized": "http://localhost:1234", "why": "upper-case host" },
    { "input": "HTTP://[::1]:1234/", "rust": false, "normalized": "http://[::1]:1234", "why": "upper-case scheme, IPv6" },

    { "input": "http://localhost:1234/V1", "rust": false, "normalized": null, "why": "paths are case-sensitive; only /v1 is stripped" },
    { "input": "http://localhost:1234/v1/v1", "rust": false, "normalized": null, "why": "only ONE trailing /v1 is stripped" },
    { "input": "http://127.0.0.1:1234//v1", "rust": false, "normalized": null, "why": "stripping /v1 leaves a slash, not a base" },
    { "input": "http://127.0.0.1:1234/v1//", "rust": false, "normalized": null, "why": "only one trailing slash is stripped" },
    { "input": "http://127.0.0.1:1234//", "rust": false, "normalized": null, "why": "two trailing slashes" },
    { "input": "https://127.0.0.1:1234", "rust": false, "normalized": null, "why": "plain http only" },
    { "input": "http://127.0.0.1", "rust": false, "normalized": null, "why": "no port" },
    { "input": "http://127.0.0.1/", "rust": false, "normalized": null, "why": "no port, trailing slash" },
    { "input": "http://127.0.0.1:", "rust": false, "normalized": null, "why": "empty port" },
    { "input": "http://127.0.0.1:0", "rust": false, "normalized": null, "why": "port 0" },
    { "input": "http://127.0.0.1:65536", "rust": false, "normalized": null, "why": "port above 65535" },
    { "input": "http://127.0.0.1:99999", "rust": false, "normalized": null, "why": "five digits, out of range" },
    { "input": "http://127.0.0.1:123456", "rust": false, "normalized": null, "why": "six digits" },
    { "input": "http://127.0.0.1:01234", "rust": false, "normalized": null, "why": "leading zero" },
    { "input": "http://127.0.0.1:+1234", "rust": false, "normalized": null, "why": "signed port" },
    { "input": "http://127.0.0.1:12 34", "rust": false, "normalized": null, "why": "space inside the port" },
    { "input": "http://127.0.0.1:\uff11\uff12\uff13\uff14", "rust": false, "normalized": null, "why": "full-width digits" },
    { "input": "http://127.0.0.2:1234", "rust": false, "normalized": null, "why": "another 127/8 address" },
    { "input": "http://127.1:1234", "rust": false, "normalized": null, "why": "short-form IPv4" },
    { "input": "http://0x7f.0.0.1:1234", "rust": false, "normalized": null, "why": "hex octet" },
    { "input": "http://0x7f000001:1234", "rust": false, "normalized": null, "why": "hex address" },
    { "input": "http://2130706433:1234", "rust": false, "normalized": null, "why": "decimal address" },
    { "input": "http://017700000001:1234", "rust": false, "normalized": null, "why": "octal address" },
    { "input": "http://0177.0.0.1:1234", "rust": false, "normalized": null, "why": "octal octet" },
    { "input": "http://127.0.0.1.:1234", "rust": false, "normalized": null, "why": "trailing dot" },
    { "input": "http://[::ffff:127.0.0.1]:1234", "rust": false, "normalized": null, "why": "IPv4-mapped IPv6" },
    { "input": "http://[0:0:0:0:0:0:0:1]:1234", "rust": false, "normalized": null, "why": "long-form ::1" },
    { "input": "http://[::01]:1234", "rust": false, "normalized": null, "why": "padded ::1" },
    { "input": "http://[::1]", "rust": false, "normalized": null, "why": "IPv6 without a port" },
    { "input": "http://::1:1234", "rust": false, "normalized": null, "why": "unbracketed IPv6" },
    { "input": "http://user@127.0.0.1:1234", "rust": false, "normalized": null, "why": "userinfo" },
    { "input": "http://user:pass@localhost:1234", "rust": false, "normalized": null, "why": "userinfo with a password" },
    { "input": "http://127.0.0.1:1234@evil.example", "rust": false, "normalized": null, "why": "loopback as userinfo of another host" },
    { "input": "http://evil.example#@127.0.0.1:1234", "rust": false, "normalized": null, "why": "fragment trick" },
    { "input": "http://127.0.0.1:1234/v1/models", "rust": false, "normalized": null, "why": "a full endpoint, not a base" },
    { "input": "http://127.0.0.1:1234/api", "rust": false, "normalized": null, "why": "a path" },
    { "input": "http://127.0.0.1:1234?x=1", "rust": false, "normalized": null, "why": "a query" },
    { "input": "http://127.0.0.1:1234#frag", "rust": false, "normalized": null, "why": "a fragment" },
    { "input": "http://127.0.0.1:1234 /", "rust": false, "normalized": null, "why": "space before the slash" },
    { "input": "http://127.0.0.1:1234\\", "rust": false, "normalized": null, "why": "backslash" },
    { "input": "http://127.0.0.1:1234\r\nX-Injected: 1", "rust": false, "normalized": null, "why": "header injection" },
    { "input": "http://127.0.0.1:1234\u0000", "rust": false, "normalized": null, "why": "NUL" },
    { "input": "http://localhost.:1234", "rust": false, "normalized": null, "why": "FQDN dot" },
    { "input": "http://LOCALHOST.:1234", "rust": false, "normalized": null, "why": "FQDN dot, upper case" },
    { "input": "http://localhost.localdomain:1234", "rust": false, "normalized": null, "why": "another loopback name" },
    { "input": "http://\uff4c\uff4f\uff43\uff41\uff4c\uff48\uff4f\uff53\uff54:1234", "rust": false, "normalized": null, "why": "full-width letters" },
    { "input": "http://%31%32%37.0.0.1:1234", "rust": false, "normalized": null, "why": "percent-encoded host" },
    { "input": "http://0.0.0.0:1234", "rust": false, "normalized": null, "why": "the unspecified address" },
    { "input": "http://192.168.1.10:1234", "rust": false, "normalized": null, "why": "a LAN address" },
    { "input": "http://example.com:1234", "rust": false, "normalized": null, "why": "a remote host" },
    { "input": "http://:1234", "rust": false, "normalized": null, "why": "empty host" },
    { "input": "127.0.0.1:1234", "rust": false, "normalized": null, "why": "no scheme" },
    { "input": "localhost:1234", "rust": false, "normalized": null, "why": "no scheme (reads as a scheme)" },
    { "input": "//127.0.0.1:1234", "rust": false, "normalized": null, "why": "scheme-relative" },
    { "input": "http:/127.0.0.1:1234", "rust": false, "normalized": null, "why": "one slash" },
    { "input": "ws://127.0.0.1:1234", "rust": false, "normalized": null, "why": "websocket" },
    { "input": "file:///etc/passwd", "rust": false, "normalized": null, "why": "a file URL" },
    { "input": "javascript:alert(1)", "rust": false, "normalized": null, "why": "script" },
    { "input": "http://", "rust": false, "normalized": null, "why": "scheme only" },
    { "input": "", "rust": false, "normalized": null, "why": "empty" }
  ]
}
