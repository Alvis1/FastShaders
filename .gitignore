# Deploy staging trees. Both are `rm -rf` + `cp -R dist` snapshots made by
# scripts/deploy-*.sh, so they are regenerated on every deploy and nothing in
# the repo reads them. dist-sferas was tracked for its first seven commits
# (added 2026-08-31 without this line, ~4-5 MiB of pack): content-hashed asset
# names mean no delta reuse, so every deploy would have added a fresh copy of
# the whole build forever. The files already committed were untracked
# alongside this entry with `git rm -r --cached dist-sferas` — an ignore line
# alone does nothing for a path git already tracks, so the entry would
# otherwise have been inert.
dist-alvismisjuns
dist-sferas
# SFTP deploy credentials (VS Code sftp extension + scripts/deploy-alvismisjuns.sh)
.vscode/sftp.json
vite.config.d.ts

# Local test assets dropped into the app (3D models etc.) — not part of the repo
.claude/_AppTestRes/

# Machine-local editor config (ShaderCarousel Live Server holds a local TLS key passphrase)
ShaderCarousel/.vscode/
# Env files must never be trackable
.env
.env.*

# Internal working material — not part of the public repo
private/

# Personal Claude Code permission allowlist (machine-local)
.claude/settings.local.json
.vscode/eval-endpoint.json
